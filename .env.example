DATABASE_URL=postgres://marsshare:marsshare@postgres:5432/marsshare?sslmode=disable
APP_MASTER_KEY=change-me-to-a-32-byte-secret!!
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
APP_BASE_URL=http://localhost:5173
API_ADDR=:8080
# CORS_ORIGIN accepts a comma-separated list of allowed browser origins.
# Use "*" to allow any origin (Bearer-token auth is unaffected).
# Examples:
#   CORS_ORIGIN=http://localhost:5173                     # vite dev only
#   CORS_ORIGIN=http://localhost:5173,http://localhost    # dev + nginx (port 80)
#   CORS_ORIGIN=https://marsshare.example.com            # single prod host
#   CORS_ORIGIN=*                                          # any origin
CORS_ORIGIN=http://localhost:5173,http://localhost,http://localhost:8080,http://localhost:8099
LOCAL_STORAGE_PATH=/data/storage
WORKER_INTERVAL=30s

# Email configuration is managed from the admin panel (Settings → 邮件设置)
