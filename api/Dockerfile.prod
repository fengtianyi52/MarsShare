# ── Build stage ──
FROM dockerproxy.net/library/golang:1.24-alpine AS builder

# 使用阿里云 Alpine 镜像源加速 apk
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# 配置 Go 模块代理（七牛云 goproxy.cn）
ENV GOPROXY=https://goproxy.cn,direct \
    GONOSUMCHECK=*

WORKDIR /build

RUN apk add --no-cache gcc musl-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/api ./cmd/api
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/worker ./cmd/worker

# ── Runtime stage ──
FROM dockerproxy.net/library/alpine:3.20

# 使用阿里云 Alpine 镜像源
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /bin/api /bin/worker /app/
COPY --from=builder /build/migrations /app/migrations

EXPOSE 8080
CMD ["/app/api"]
